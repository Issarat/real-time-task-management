@model KanbanBoardViewModel
@{
    ViewData["Title"] = Model.ProjectName;
    Layout = "/Views/Shared/_DashboardLayout.cshtml";
    var members = Model.Members ?? [];
    var visibleMembers = members.Take(4).ToArray();
    var additionalMemberCount = Math.Max(0, members.Count - visibleMembers.Length);
}

@section Styles {
    <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" />
}

@if (TempData["BoardMessage"] is string boardMessage)
{
    <div class="project-toast" role="status" aria-atomic="true" data-project-toast data-auto-dismiss-ms="5000">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.5 12.5 3 3 8-8" /></svg>
        <span>@boardMessage</span>
        <button type="button" data-toast-dismiss aria-label="ปิดการแจ้งเตือน">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" /></svg>
        </button>
    </div>
}

<section class="board-page" data-board-root data-project-id="@Model.ProjectId">
    <header class="project-header">
        <div>
            <div class="project-title-row">
                <h1>@Model.ProjectName</h1>
                <span class="project-status"><i></i> พร้อมใช้งาน</span>
                @if (Model.CanEditProject)
                {
                    <button class="project-edit-button"
                            type="button"
                            data-dialog-open="edit-project-dialog">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m4 16-.75 4.25L7.5 19.5 18 9l-3-3L4 16Z" /><path d="m13.5 7.5 3 3" /></svg>
                        แก้ไขโปรเจกต์
                    </button>
                }
            </div>
            <p>@Model.ProjectDescription</p>
        </div>

        <div class="project-members" aria-label="สมาชิกโปรเจกต์ @members.Count คน">
            <div class="avatar-stack">
                @foreach (var member in visibleMembers)
                {
                    <span class="avatar avatar-@member.Tone"
                          title="@member.DisplayName (@member.Role)">
                        @member.Initials
                    </span>
                }
                @if (additionalMemberCount > 0)
                {
                    <span class="member-count">+@additionalMemberCount</span>
                }
            </div>
            @if (Model.CanEditProject)
            {
                <button class="invite-button"
                        type="button"
                        data-dialog-open="invite-member-dialog"
                        title="เชิญสมาชิก"
                        aria-label="เชิญสมาชิก">+</button>
            }
        </div>
    </header>

    <div class="board-toolbar">
        <div class="board-tabs" role="tablist" aria-label="รูปแบบการแสดงงาน">
            <button class="is-active" type="button" role="tab" aria-selected="true">Board</button>
            <button type="button" role="tab" aria-selected="false" disabled>List</button>
        </div>

        <div class="board-tools">
            <button class="board-add-task"
                    type="button"
                    data-dialog-open="create-task-dialog">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                เพิ่มงานใหม่
            </button>
            <button type="button" disabled title="ตัวกรองจะเพิ่มในขั้นถัดไป">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5h16l-6 7v5l-4 2v-7z" /></svg>
                ตัวกรอง
            </button>
            <button type="button" disabled title="การจัดเรียงจะเพิ่มในขั้นถัดไป">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 6h12M8 12h9M8 18h6M4 6h.01M4 12h.01M4 18h.01" /></svg>
                จัดเรียง
            </button>
            <button class="more-button" type="button" disabled aria-label="ตัวเลือกเพิ่มเติม">•••</button>
        </div>
    </div>

    <div class="kanban-board" aria-label="Kanban board">
        @foreach (var column in Model.Columns)
        {
            <section class="kanban-column" data-board-column="@column.Id">
                <header class="column-header">
                    <div>
                        <span class="column-dot tone-@column.Tone" aria-hidden="true"></span>
                        <h2>@column.Name</h2>
                        <span class="column-count tone-@column.Tone">@column.Tasks.Count</span>
                    </div>
                </header>

                <div class="task-list">
                    @foreach (var task in column.Tasks)
                    {
                        <a asp-controller="Projects"
                           asp-action="TaskDetails"
                           asp-route-slug="@Model.ProjectSlug"
                           asp-route-taskId="@task.Id"
                           class="task-card"
                           data-task-card
                           data-search-text="@($"{task.Title} {task.Description} {task.Tag} {task.AssigneeName}")"
                           aria-label="ดูรายละเอียดงาน @task.Title">
                            <span class="task-tag tag-@task.TagTone">@task.Tag</span>
                            <h3>@task.Title</h3>
                            @if (!string.IsNullOrWhiteSpace(task.Description))
                            {
                                <p>@task.Description</p>
                            }

                            @if (task.Priority == "High")
                            {
                                <span class="priority-badge"><i></i> สำคัญ</span>
                            }

                            <footer class="task-footer">
                                <div class="task-meta">
                                    @if (!string.IsNullOrWhiteSpace(task.DueDate))
                                    {
                                        <span>
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="2" /><path d="M8 3v4M16 3v4M4 10h16" /></svg>
                                            @task.DueDate
                                        </span>
                                    }
                                    @if (task.IsCompleted)
                                    {
                                        <span class="task-completed" title="เสร็จแล้ว">
                                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.5 12.5 3 3 8-8" /></svg>
                                        </span>
                                    }
                                </div>
                                <span class="avatar avatar-small avatar-@task.AssigneeTone"
                                      title="ผู้รับผิดชอบ: @task.AssigneeName">
                                    @task.AssigneeInitials
                                </span>
                            </footer>
                        </a>
                    }
                    <p class="column-empty @(column.Tasks.Count > 0 ? "is-hidden" : null)" data-column-empty>
                        ยังไม่มีงานในคอลัมน์นี้
                    </p>
                </div>

            </section>
        }
    </div>
</section>

@if (Model.CanEditProject)
{
    <dialog id="edit-project-dialog"
            class="project-dialog"
            aria-labelledby="edit-project-title"
            data-open-on-load="@Model.OpenEditProjectModal.ToString().ToLowerInvariant()">
        <form asp-controller="Projects"
              asp-action="UpdateProjectName"
              asp-route-slug="@Model.ProjectSlug"
              method="post"
              class="project-dialog-card">
            <header class="project-dialog-header">
                <div class="project-dialog-heading">
                    <span class="project-dialog-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24"><path d="m4 16-.75 4.25L7.5 19.5 18 9l-3-3L4 16Z" /><path d="m13.5 7.5 3 3" /></svg>
                    </span>
                    <div>
                        <h2 id="edit-project-title">แก้ไขชื่อโปรเจกต์</h2>
                        <p>ตั้งชื่อที่ช่วยให้ทีมค้นหาโปรเจกต์นี้ได้ง่าย</p>
                    </div>
                </div>
                <button class="dialog-close-button" type="button" data-dialog-close aria-label="ปิดหน้าต่าง">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                </button>
            </header>

            <div class="project-dialog-body">
                <div asp-validation-summary="ModelOnly" class="project-validation-summary" role="alert"></div>

                <div class="project-form-field">
                    <label asp-for="EditProject.Name">ชื่อโปรเจกต์ <span>*</span></label>
                    <input asp-for="EditProject.Name"
                           maxlength="120"
                           autocomplete="off"
                           data-dialog-autofocus />
                    <span asp-validation-for="EditProject.Name" class="project-field-validation"></span>
                </div>
            </div>

            <footer class="project-dialog-footer">
                <button class="dialog-cancel-button" type="button" data-dialog-close>ยกเลิก</button>
                <button class="dialog-submit-button" type="submit">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6.5 12.5 3 3 8-8" /></svg>
                    บันทึก
                </button>
            </footer>
        </form>
    </dialog>

    <dialog id="invite-member-dialog"
            class="project-dialog"
            aria-labelledby="invite-member-title"
            data-open-on-load="@Model.OpenInviteModal.ToString().ToLowerInvariant()">
        @if (!string.IsNullOrWhiteSpace(Model.GeneratedInviteCode))
        {
            <div class="project-dialog-card">
                <header class="project-dialog-header">
                    <div class="project-dialog-heading">
                        <span class="project-dialog-icon project-dialog-icon-success" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m6.5 12.5 3 3 8-8" /></svg>
                        </span>
                        <div>
                            <h2 id="invite-member-title">Invite Code พร้อมแล้ว</h2>
                            <p>ส่งรหัสนี้ให้สมาชิกที่ต้องการเชิญเข้าโปรเจกต์</p>
                        </div>
                    </div>
                    <button class="dialog-close-button" type="button" data-dialog-close aria-label="ปิดหน้าต่าง">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                    </button>
                </header>

                <div class="project-dialog-body">
                    <label class="generated-invite-label" for="generated-invite-code">Invite Code</label>
                    <div class="generated-invite-row">
                        <input id="generated-invite-code"
                               value="@Model.GeneratedInviteCode"
                               readonly
                               spellcheck="false"
                               data-generated-invite-code />
                        <button type="button" data-invite-copy>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" /></svg>
                            <span data-invite-copy-label>คัดลอก</span>
                        </button>
                    </div>
                    <p class="invite-copy-status" role="status" aria-live="polite" data-invite-copy-status></p>

                    <div class="invite-code-help">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
                        <p>
                            <strong>รายละเอียด Invite Code</strong>
                            หมดอายุ @Model.GeneratedInviteExpiresAt และใช้ได้สูงสุด @Model.GeneratedInviteMaxUses ครั้ง
                        </p>
                    </div>
                </div>

                <footer class="project-dialog-footer">
                    <button class="dialog-submit-button" type="button" data-dialog-close>เสร็จสิ้น</button>
                </footer>
            </div>
        }
        else
        {
            <form asp-controller="Projects"
                  asp-action="CreateInvite"
                  asp-route-slug="@Model.ProjectSlug"
                  method="post"
                  class="project-dialog-card">
                <header class="project-dialog-header">
                    <div class="project-dialog-heading">
                        <span class="project-dialog-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M16 11h6" /></svg>
                        </span>
                        <div>
                            <h2 id="invite-member-title">เชิญสมาชิก</h2>
                            <p>สร้าง Invite Code สำหรับโปรเจกต์ @Model.ProjectName</p>
                        </div>
                    </div>
                    <button class="dialog-close-button" type="button" data-dialog-close aria-label="ปิดหน้าต่าง">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
                    </button>
                </header>

                <div class="project-dialog-body">
                    <div asp-validation-summary="ModelOnly" class="project-validation-summary" role="alert"></div>

                    <div class="project-form-field">
                        <label asp-for="CreateInvite.ExpirationDays">อายุ Invite Code</label>
                        <select asp-for="CreateInvite.ExpirationDays" data-dialog-autofocus>
                            <option value="1">1 วัน</option>
                            <option value="7">7 วัน</option>
                            <option value="14">14 วัน</option>
                            <option value="30">30 วัน</option>
                        </select>
                        <span asp-validation-for="CreateInvite.ExpirationDays" class="project-field-validation"></span>
                    </div>

                    <div class="project-form-field">
                        <label asp-for="CreateInvite.MaxUses">จำนวนครั้งที่ใช้ได้</label>
                        <select asp-for="CreateInvite.MaxUses">
                            <option value="1">1 คน</option>
                            <option value="5">5 คน</option>
                            <option value="10">10 คน</option>
                            <option value="25">25 คน</option>
                            <option value="50">50 คน</option>
                        </select>
                        <span asp-validation-for="CreateInvite.MaxUses" class="project-field-validation"></span>
                    </div>

                    <div class="invite-code-help">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
                        <p>
                            <strong>สิทธิ์ของสมาชิกที่เข้าร่วม</strong>
                            ผู้ที่ใช้โค้ดจะเข้าร่วมในบทบาท Member และไม่สามารถสร้าง Invite Code ใหม่ได้
                        </p>
                    </div>
                </div>

                <footer class="project-dialog-footer">
                    <button class="dialog-cancel-button" type="button" data-dialog-close>ยกเลิก</button>
                    <button class="dialog-submit-button" type="submit">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M16 11h6" /></svg>
                        สร้าง Invite Code
                    </button>
                </footer>
            </form>
        }
    </dialog>
}

<dialog id="create-task-dialog"
        class="project-dialog task-dialog"
        aria-labelledby="create-task-title"
        data-open-on-load="@Model.OpenCreateTaskModal.ToString().ToLowerInvariant()">
    <form asp-controller="Projects"
          asp-action="CreateTask"
          asp-route-slug="@Model.ProjectSlug"
          method="post"
          class="project-dialog-card">
        <header class="project-dialog-header">
            <div class="project-dialog-heading">
                <span class="project-dialog-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                </span>
                <div>
                    <h2 id="create-task-title">เพิ่มงานใหม่</h2>
                    <p>เพิ่มงานลงในบอร์ด @Model.ProjectName</p>
                </div>
            </div>
            <button class="dialog-close-button" type="button" data-dialog-close aria-label="ปิดหน้าต่าง">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
            </button>
        </header>

        <div class="project-dialog-body">
            <div asp-validation-summary="ModelOnly" class="project-validation-summary" role="alert"></div>

            <div class="project-form-field">
                <label asp-for="CreateTask.BoardColumnId">คอลัมน์ <span>*</span></label>
                <select asp-for="CreateTask.BoardColumnId">
                    @foreach (var column in Model.Columns)
                    {
                        <option value="@column.Id">@column.Name</option>
                    }
                </select>
                <span asp-validation-for="CreateTask.BoardColumnId" class="project-field-validation"></span>
            </div>

            <div class="project-form-field">
                <label asp-for="CreateTask.Title">ชื่องาน <span>*</span></label>
                <input asp-for="CreateTask.Title"
                       placeholder="เช่น ออกแบบหน้า Dashboard"
                       autocomplete="off"
                       data-dialog-autofocus />
                <span asp-validation-for="CreateTask.Title" class="project-field-validation"></span>
            </div>

            <div class="project-form-field">
                <label asp-for="CreateTask.Description">รายละเอียด <em>ไม่บังคับ</em></label>
                <textarea asp-for="CreateTask.Description"
                          rows="4"
                          placeholder="รายละเอียดของงาน"></textarea>
                <span asp-validation-for="CreateTask.Description" class="project-field-validation"></span>
            </div>

            <div class="project-form-field">
                <label asp-for="CreateTask.Priority">ความสำคัญ</label>
                <select asp-for="CreateTask.Priority">
                    <option value="Low">ต่ำ</option>
                    <option value="Medium">ปานกลาง</option>
                    <option value="High">สูง</option>
                </select>
            </div>
        </div>

        <footer class="project-dialog-footer">
            <button class="dialog-cancel-button" type="button" data-dialog-close>ยกเลิก</button>
            <button class="dialog-submit-button" type="submit">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
                เพิ่มงาน
            </button>
        </footer>
    </form>
</dialog>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/projects.js" asp-append-version="true"></script>
}
