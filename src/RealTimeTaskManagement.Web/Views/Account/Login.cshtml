@model LoginViewModel
@{
    ViewData["Title"] = "เข้าสู่ระบบ";
    Layout = "/Views/Shared/_AuthLayout.cshtml";
}

<div class="auth-page">
    <main class="auth-shell" aria-labelledby="login-title">
        <section class="auth-promo" aria-label="เกี่ยวกับ TaskFlow">
            <div class="promo-glow promo-glow-top"></div>
            <div class="promo-glow promo-glow-bottom"></div>

            <div class="brand">
                <span class="brand-mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" role="img">
                        <path d="m7.5 12 3 3 6-6" />
                    </svg>
                </span>
                <span>TaskFlow</span>
            </div>

            <div class="promo-content">
                <div class="promo-badge">
                    <span class="promo-badge-dot"></span>
                    ทำงานร่วมกันแบบเรียลไทม์
                </div>

                <h2>จัดการทุกงาน<br /><span>ให้เดินหน้าไปด้วยกัน</span></h2>
                <p>
                    วางแผน มอบหมาย และติดตามความคืบหน้าของทีม
                    จากบอร์ดเดียวที่ทุกคนเห็นตรงกัน
                </p>

                <div class="benefit-card">
                    <div class="benefit-item">
                        <span class="benefit-icon benefit-icon-blue" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m6.5 12.5 3 3 8-8" /></svg>
                        </span>
                        <div>
                            <strong>เห็นความคืบหน้าทันที</strong>
                            <small>ทุกการเปลี่ยนแปลงอัปเดตแบบเรียลไทม์</small>
                        </div>
                    </div>

                    <div class="benefit-divider"></div>

                    <div class="benefit-item">
                        <span class="benefit-icon benefit-icon-green" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14" /></svg>
                        </span>
                        <div>
                            <strong>เริ่มต้นได้ในไม่กี่นาที</strong>
                            <small>สร้างโปรเจกต์และเชิญทีมด้วย Invite Code</small>
                        </div>
                    </div>
                </div>
            </div>

            <div class="promo-footer">
                <div class="avatar-stack" aria-hidden="true">
                    <span></span><span></span><span></span>
                </div>
                <span>พื้นที่ทำงานที่ออกแบบมาเพื่อทีมของคุณ</span>
            </div>
        </section>

        <section class="auth-form-panel">
            <div class="auth-form-container">
                <div class="auth-switch">
                    <span>ยังไม่มีบัญชี?</span>
                    <a asp-controller="Account"
                       asp-action="Register"
                       asp-route-returnUrl="@Model.ReturnUrl">สมัครสมาชิก</a>
                </div>

                <header class="auth-heading">
                    <div class="mobile-brand">
                        <span class="brand-mark" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="m7.5 12 3 3 6-6" /></svg>
                        </span>
                        <span>TaskFlow</span>
                    </div>
                    <p class="auth-eyebrow">ยินดีต้อนรับกลับมา</p>
                    <h1 id="login-title">เข้าสู่ระบบบัญชีของคุณ</h1>
                    <p>กลับไปจัดการโปรเจกต์และทำงานร่วมกับทีมของคุณ</p>
                </header>

                <form id="account"
                      asp-controller="Account"
                      asp-action="Login"
                      method="post"
                      class="auth-form">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                    <div class="field-group">
                        <label asp-for="Email">อีเมล</label>
                        <div class="input-shell">
                            <span class="input-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="5" width="18" height="14" rx="3" />
                                    <path d="m5 8 7 5 7-5" />
                                </svg>
                            </span>
                            <input asp-for="Email"
                                   type="email"
                                   autocomplete="username"
                                   placeholder="name@company.com"
                                   autofocus />
                        </div>
                        <span asp-validation-for="Email" class="field-validation"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Password">รหัสผ่าน</label>
                        <div class="input-shell">
                            <span class="input-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <rect x="5" y="10" width="14" height="11" rx="3" />
                                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                </svg>
                            </span>
                            <input asp-for="Password"
                                   id="login-password"
                                   type="password"
                                   autocomplete="current-password"
                                   placeholder="กรอกรหัสผ่าน" />
                            <button type="button"
                                    class="password-toggle"
                                    id="password-toggle"
                                    aria-label="แสดงรหัสผ่าน"
                                    aria-pressed="false">
                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                                    <circle cx="12" cy="12" r="2.5" />
                                </svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation"></span>
                    </div>

                    <label class="remember-option" asp-for="RememberMe">
                        <input asp-for="RememberMe" />
                        <span>จดจำการเข้าสู่ระบบ</span>
                    </label>

                    <button id="login-submit" type="submit" class="primary-action">
                        เข้าสู่ระบบ
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14M14 7l5 5-5 5" />
                        </svg>
                    </button>

                    <p class="auth-privacy">
                        การเข้าสู่ระบบถือว่าคุณยอมรับ
                        <a asp-controller="Home" asp-action="Privacy">นโยบายความเป็นส่วนตัว</a>
                    </p>
                </form>
            </div>
        </section>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const input = document.getElementById('login-password');
            const toggle = document.getElementById('password-toggle');

            if (!input || !toggle) return;

            toggle.addEventListener('click', () => {
                const shouldShow = input.type === 'password';
                input.type = shouldShow ? 'text' : 'password';
                toggle.setAttribute('aria-pressed', shouldShow.toString());
                toggle.setAttribute('aria-label', shouldShow ? 'ซ่อนรหัสผ่าน' : 'แสดงรหัสผ่าน');
            });
        })();
    </script>
}
